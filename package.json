{
  "name": "portfolio",
  "private": true,
  "version": "0.1.12",
  "type": "module",
  "scripts": {
    "gen:version": "node scripts/gen-version.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && vite-react-ssg build && node scripts/gen-seo.mjs && node scripts/gen-sw.mjs",
    "preview": "vite preview",
    "typecheck": "npm run gen && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "gen:covers": "node scripts/gen-covers.mjs",
    "gen": "npm run gen:version && npm run gen:covers",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.12",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@fontsource-variable/archivo": "^5.1.0",
    "@fontsource-variable/newsreader": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@playwright/test": "^1.49.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^18.0.9",
    "pdfjs-dist": "^6.2.108",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-react-ssg": "^0.8.1",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.0.0"
  }
}
